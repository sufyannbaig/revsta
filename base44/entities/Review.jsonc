{
  "name": "Review",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "reddit",
        "youtube",
        "quora",
        "facebook",
        "instagram",
        "linkedin"
      ]
    },
    "author": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative"
      ]
    },
    "sentiment_score": {
      "type": "number"
    },
    "source_url": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "product_id",
    "platform",
    "content",
    "sentiment"
  ]
}